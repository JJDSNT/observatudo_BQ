CUBEJS_DEV_MODE=true
CUBEJS_API_SECRET=changeme-local-dev-secret

CUBEJS_DB_TYPE=bigquery
CUBEJS_DB_BQ_PROJECT_ID=observatudo-infra

# Local: deixe em branco para usar as Application Default Credentials já
# configuradas na máquina (gcloud auth application-default login) — mesma
# auth usada pelo resto do projeto (Python, Terraform). Em produção,
# preencher com o caminho de uma key file de uma service account dedicada
# (leitura só em `gold`; ainda não provisionada — depende da decisão de
# deploy, ver docs/external/cubejs.md).
CUBEJS_DB_BQ_KEY_FILE=

# Deploy decidido: self-hosted via Cloud Run, com o bucket GCS existente
# (*-www-data) como apoio (export de resultados grandes do BigQuery e/ou
# pre-agregações) — ver "Pontos abertos" em docs/external/cubejs.md. Ainda
# não provisionado (sem IAM dedicada); deixe em branco até decidir.
CUBEJS_DB_EXPORT_BUCKET=
